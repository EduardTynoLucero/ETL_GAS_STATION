# =====================================================================
# Configuración del ETL_GAS_STATION
# Copia este archivo como .env (si no existe) y pon tus datos de PostgreSQL.
# Si la contraseña tiene # o espacios al inicio o al final, escríbela entre comillas dobles: PGPASSWORD="mi #clave"
# Si tiene comillas dobles, usa comillas simples: PGPASSWORD='mi"clave'
# =====================================================================

# --- Conexión a PostgreSQL (servidor Dokploy) ---
# Desde tu PC: la IP del servidor. Si el ETL corre dentro de Dokploy: expensesproject-gasstationdb-dt5gda
PGHOST=72.62.80.172
PGPORT=5432
# La base y el usuario que muestra Dokploy en Internal Credentials.
# La base ya existe: "npm run instalar-bd" solo le crea las tablas
PGDATABASE=gas_station_db
PGUSER=gas_station_db
# La contraseña de Dokploy tal cual, con su @ (aquí no se escribe %40)
PGPASSWORD=GasStation@2026
# true si el servidor exige conexión cifrada (el PostgreSQL de Dokploy no la usa)
PGSSL=false
# Solo con PGSSL=true y un certificado propio: ruta al archivo .crt o .pem de la autoridad
PGSSL_CA=

# --- Datos del reporte ---
# Para archivos que no traen la columna Estación (exportaciones viejas)
ETL_ESTACION_POR_DEFECTO=PCONC - GASOLINERA CONCEPCION LAS MINAS
# Quién sube los archivos; si se deja vacío se usa el usuario de Windows
ETL_USUARIO=

# --- Carpeta vigilada (npm run vigilar) ---
# Rutas relativas a la carpeta del proyecto, o completas (C:\ruta\entrada)
ETL_CARPETA_ENTRADA=entrada
ETL_CARPETA_PROCESADOS=procesados
ETL_CARPETA_RECHAZADOS=rechazados
# Cada cuántos segundos revisa la carpeta de entrada
ETL_INTERVALO_VIGILAR_SEG=30

# --- Panel web (npm run panel) ---
# Puerto del panel: se abre en http://localhost:3100
PANEL_PUERTO=3100
# false para que no abra el navegador solo al arrancar
PANEL_ABRIR=true

# --- Mantenimiento ---
# Días que se guardan los tickets tal como vinieron (esquema stg); el modelo no se borra nunca
ETL_DIAS_STAGING=30

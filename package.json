{
  "name": "etl-gas-station",
  "version": "1.0.0",
  "private": true,
  "description": "ETL del reporte Consulta de Tickets (BISS) hacia un modelo OLAP en PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "instalar-bd": "tsx src/cli.ts instalar-bd",
    "probar-conexion": "tsx src/cli.ts probar-conexion",
    "validar": "tsx src/cli.ts validar",
    "cargar": "tsx src/cli.ts cargar",
    "vigilar": "tsx src/cli.ts vigilar",
    "panel": "tsx src/panel/servidor.ts",
    "dev": "tsx src/panel/servidor.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "echarts": "^5.6.0",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
